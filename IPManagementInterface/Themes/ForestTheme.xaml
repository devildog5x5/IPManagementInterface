<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Themes/Colors.xaml"/>
    </ResourceDictionary.MergedDictionaries>
    
    <!-- Forest Theme - Natural Greens and Earth Tones -->
    <Color x:Key="Forest_Dark">#1B4332</Color>
    <Color x:Key="Forest_Medium">#2D6A4F</Color>
    <Color x:Key="Forest_Light">#52B788</Color>
    <Color x:Key="Forest_Accent">#95D5B2</Color>
    <Color x:Key="Forest_Background">#E8F5E9</Color>
    <Color x:Key="Forest_Surface">#F1F8F4</Color>
    <Color x:Key="Forest_Text">#1B3A2E</Color>
    <Color x:Key="Forest_TextSecondary">#4A7C5F</Color>
    <Color x:Key="Forest_Border">#A8D5BA</Color>
    
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource Forest_Background}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource Forest_Surface}"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource Forest_Text}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource Forest_TextSecondary}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource Forest_Border}"/>
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Forest_Medium}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Forest_Light}"/>
    
</ResourceDictionary>

