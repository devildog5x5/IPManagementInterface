<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Themes/Colors.xaml"/>
    </ResourceDictionary.MergedDictionaries>
    
    <!-- Cyber Theme - Neon Tech Aesthetic -->
    <Color x:Key="Cyber_Dark">#0D1117</Color>
    <Color x:Key="Cyber_Surface">#161B22</Color>
    <Color x:Key="Cyber_NeonGreen">#39FF14</Color>
    <Color x:Key="Cyber_NeonBlue">#00F5FF</Color>
    <Color x:Key="Cyber_NeonPink">#FF00FF</Color>
    <Color x:Key="Cyber_Text">#C9D1D9</Color>
    <Color x:Key="Cyber_TextSecondary">#8B949E</Color>
    <Color x:Key="Cyber_Border">#30363D</Color>
    
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource Cyber_Dark}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource Cyber_Surface}"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource Cyber_Text}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource Cyber_TextSecondary}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource Cyber_Border}"/>
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Cyber_NeonGreen}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Cyber_NeonBlue}"/>
    
</ResourceDictionary>

